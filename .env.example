# Reuse the same API gateway environment as the existing FMS Portal.
# Values below match the currently supplied FMS_Portal .env.
API_1_URL=https://api.hosexperts.com:85/apiv2.php
API_2_URL=https://api.hosexperts.com:85/apiv2.php
API_AUTH_TOKEN=
APP_NAME="Task 360"
ENVIRONMENT=production
REQUEST_TIMEOUT=15
PORT=8000

# Select which configured API/database the dashboard reads from.
# API_1 is the Test_OperationsDB/apiv2.php path in the existing portal convention.
# Change to API_2 only when API_2_URL points to the intended target database API.
KPI_API_BASE=API_1

# Set this to the merged KPI table name exposed by the API gateway.
# Use the table naming format expected by the API (existing portals commonly omit dbo.).
KPI_SQL_TABLE=REPLACE_WITH_MERGED_KPI_TABLE

# Employee identity, email, code, and role data are fetched through the same API.
VM_EMPLOYEE_TABLE=VM_EmployeeMaster
KPI_SQL_CACHE_SECONDS=30
KPI_SQL_MAX_ROWS=100000
VM_EMPLOYEE_CACHE_SECONDS=300
EMPLOYEE_ADMIN_ROLE_IDS=1
EMPLOYEE_MANAGER_ROLE_IDS=
